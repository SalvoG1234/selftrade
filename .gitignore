# agent workspace metadata: local tooling state, never part of the project
.freebuff/
.claude/

# editors
.idea/
.vscode/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# virtualenv / caches
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# runtime state and outputs
state/
reports/
reports_synthetic/
data/*.csv
data/*.json
!data/.gitkeep

# generated / local config
.mcp.json
node_modules/
.secrets
*.env
.env

# exported strategies are regenerated by `export`
user_data/strategies/*.py
!user_data/strategies/.gitkeep

# scratch from a verification run: never part of the project, never to be published
.tmp-*/
.tmp*
*.sqlite
*.sqlite3
*.db
*.log
cookies.txt

# test/coverage output
.coverage
htmlcov/
.pytest-junit.xml
